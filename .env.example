# Database Configuration (Neon PostgreSQL)
DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@ep-steep-mountain-avtk0rs3-pooler.c-11.us-east-1.aws.neon.tech/neondb?channel_binding=require&sslmode=require

# Authentication (Neon Auth)
NEON_AUTH_BASE_URL=https://ep-steep-mountain-avtk0rs3.neonauth.c-11.us-east-1.aws.neon.tech/neondb/auth
NEON_AUTH_COOKIE_SECRET=your_super_secret_cookie_string_here

# Vercel Blob Storage (For PDF Uploads)
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_your_token_here

# MCP Configuration (Optional)
# If your MCP server is hosted separately (e.g. on Render), set this URL so the dashboard generates the right connection config
NEXT_PUBLIC_MCP_URL=https://jobtracker-mcp.onrender.com
